{
  "id": "ACA02",
  "slug": "shear_flexible_beam",
  "title": "Short cantilever: Timoshenko shear flexibility",
  "reference_kind": "independently_computed_analytical",
  "references": [
    {
      "title": "University of Alberta: Timoshenko Beam",
      "url": "https://engcourses-uofa.ca/books/introduction-to-solid-mechanics/plane-beam-approximations/timoshenko-beam/",
      "supports": "Effective shear area and independent section rotation."
    },
    {
      "title": "University of Alberta: Euler Bernoulli Beam",
      "url": "https://engcourses-uofa.ca/books/introduction-to-solid-mechanics/plane-beam-approximations/euler-bernoulli-beam/",
      "supports": "Beam assumptions and EI times fourth displacement derivative equals load; analytical cantilever response is independently derived."
    }
  ],
  "equations": [
    "G=E/(2*(1+nu))",
    "A_s=kappa*A, kappa=5/6 explicitly specified",
    "w_tip=F*L^3/(3*EI)+F*L/(kappa*G*A)",
    "theta_tip=F*L^2/(2*EI)"
  ],
  "applicability": "Exact response of the one-dimensional Timoshenko model with user-selected effective shear area; not a three-dimensional elasticity reference.",
  "boundary_conditions_and_loads": [
    "x=0: uy=rz=0; every GRID: ux=uz=rx=ry=0 (one bending plane).",
    "Global +Y tip force100N. Effective shear area explicitly5/6 of gross area."
  ],
  "units": "SI: m, N, kg, s, Pa",
  "acceptance": {
    "relative_error_percent": 0.01,
    "justification": "Declared before execution. Beam/membrane values test exact element/model equations; thin laminate tolerance allows finite mesh convergence and thin-theory/model differences. All errors remain reported."
  },
