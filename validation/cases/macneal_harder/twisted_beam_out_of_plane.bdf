CQUAD4,10, 1,19,21,22,20
CQUAD4,11, 1,21,23,24,22
CQUAD4,12, 1,23,25,26,24
$ ---- clamp at root ----
SPC1, 1, 123456, 1, 2
$ ---- out-of-plane tip load Fy = 1 distributed across the two tip nodes ----
FORCE, 1,25, , 0.5, 0.0, 1.0, 0.0
FORCE, 1,26, , 0.5, 0.0, 1.0, 0.0
ENDDATA
