{
  "id": "ACA04",
  "slug": "cross_ply_vibration",
  "title": "Symmetric cross-ply plate: Navier vibration",
  "reference_kind": "independently_computed_analytical",
  "references": [
    {
      "title": "Leissa, Vibration of Plates, NASA SP-160 (1969)",
      "url": "https://ntrs.nasa.gov/citations/19700009156",
      "supports": "Classical rectangular and anisotropic plate vibration theory."
    },
    {
      "title": "Nachiketa Tiwari / IIT Kanpur: Mechanics of Laminated Composite Structures, Lecture37 Buckling of Plates",
      "url": "https://archive.nptel.ac.in/content/storage2/courses/112104161/L37.pdf",
      "supports": "Finite symmetric specially orthotropic plate simply supported on all four sides, sinusoidal mode solution, uniaxial and biaxial buckling."
    }
  ],
  "equations": [
    "D_ij=sum_k Qbar_ij(k)*(z_k^3-z_(k-1)^3)/3",
    "alpha=m*pi/a; beta=n*pi/b",
    "H=D11*alpha^4+2*(D12+2D66)*alpha^2*beta^2+D22*beta^4",
    "f_mn=sqrt(H/(rho*t))/(2*pi)"
  ],
  "applicability": "Thin, flat, symmetric specially orthotropic laminate: B=D16=D26=0. Navier theory excludes transverse-shear deformation. The finite-element model adds transverse-shear flexibility and discretization effects. The modal case uses reference-surface mass without independent rotary inertia, matching that reference assumption. Edge-normal w constrained, bending rotations free. First six roots are compared in ascending order.",
  "boundary_conditions_and_loads": [
    "All four edges: uz=0; rotations rx,ry free. All GRID rz=0. x=0: ux=0. Origin: uy=0.",
    "Free vibration with density1600kg/m3 in each ply; no applied load."
  ],
  "units": "SI: m, N, kg, s, Pa",
  "acceptance": {
    "relative_error_percent": 2.0,
    "justification": "Declared before execution. Beam/membrane values test exact element/model equations; thin laminate tolerance allows finite mesh convergence and thin-theory/model differences. All errors remain reported."
  },
