  "slug": "nonlinear_membrane",
  "title": "Finite-strain membrane: homogeneous uniaxial tension",
  "reference_kind": "independently_computed_analytical",
  "references": [
    {
      "title": "Idaho National Laboratory MOOSE: ComputeStVenantKirchhoffStress",
      "url": "https://mooseframework.inl.gov/source/materials/lagrangian/ComputeStVenantKirchhoffStress.html",
      "supports": "S=C:E using Green-Lagrange strain; P=F S. This is a theoretical benchmark, not an experimental material calibration."
    }
  ],
  "equations": [
    "F_2D=diag(lambda,mu); E_GL,2D=(F_2D^T*F_2D-I_2D)/2; thickness strain condensed by plane stress",
    "S_yy=0 implies mu=sqrt(1-nu*(lambda^2-1))",
    "P_xx=lambda*S_xx=E*lambda*(lambda^2-1)/2",
    "F_total=P_xx*b*t; u_tip=(lambda-1)*L"
  ],
  "applicability": "Homogeneous in-plane finite-strain reduced plane-stress St Venant-Kirchhoff membrane verification. Thickness strain is condensed, not fixed to zero. All normal displacement and rotational DOFs constrained. This tests geometric nonlinear equations, not finite-rotation bending, plasticity, or measured material response.",
  "boundary_conditions_and_loads": [
    "Every GRID: uz=rx=ry=rz=0. x=0: ux=0. Origin: uy=0. Other in-plane DOFs free.",
    "Constant reference-direction traction on x=L; consistent nodal forces, half weight at corners. Ten continuation steps; independent loadlevels solve from zero."
  ],
  "units": "SI: m, N, kg, s, Pa",
  "acceptance": {
    "relative_error_percent": 0.01,
    "justification": "Declared before execution. Beam/membrane values test exact element/model equations; thin laminate tolerance allows finite mesh convergence and thin-theory/model differences. All errors remain reported."
