#!/usr/bin/env bash
# ====================================================================
#  jfem - simplest way to analyze a .bdf on Linux / macOS.
#
#    ./jfem  model.bdf
#    ./jfem  model.bdf  my_output_folder
#    ./jfem  -rs  model.bdf            (choose which outputs to write)
#
#  The solution sequence (SOL 101/103/105/106) is auto-detected from the
#  deck. By default it writes the viewer-ready set (.jfem + REPORT.md + JSON)
#  to <deck_dir>/<deckname>_out/, or to the folder you name.
#
#  Optional output-format string BEFORE the deck (a '-' then letters, any
#  order): j=.jfem viewer  r=REPORT.md  s=results JSON  v=VTK  h=HDF5
#  m=model JSON  c=card inventory.  e.g.  ./jfem -jrsv model.bdf out
#
#  Make it executable once:   chmod +x jfem
#  Tip: symlink it onto your PATH (e.g. ln -s "$PWD/jfem" ~/.local/bin/jfem)
#  so you can run `jfem` from anywhere. Uses whatever `julia` is on PATH
# (Julia 1.13.1); auto-images require matching source/build provenance.
# ====================================================================
set -euo pipefail

# Resolve this script's own directory, following symlinks.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO_ROOT="$(cd -P "$(dirname "$SOURCE")/../../.." >/dev/null 2>&1 && pwd)"
JULIA_BIN="${JFEM_JULIA:-julia}"
if ! command -v "$JULIA_BIN" >/dev/null 2>&1; then
  echo "Julia was not found. Install it from https://julialang.org/downloads/ and run the setup launcher in __Start here!__ for your operating system." >&2
  exit 1
fi

if [ "$#" -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  echo "usage:  jfem  [-formats]  <model.bdf>  [output_folder]"
  echo "example: jfem  ~/models/my_model.bdf"
  echo "example: jfem  -rs  ~/models/my_model.bdf"
  [ "$#" -lt 1 ] && exit 1 || exit 0
fi

exec "$JULIA_BIN" --startup-file=no --threads=1 \
  "$REPO_ROOT/utils/julia_tools/launch.jl" solver "$REPO_ROOT" \
  "$REPO_ROOT/utils/julia_tools/jfem.jl" "$@"
