* text=auto

*.jl text eol=lf
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Published documents must retain their exact reviewed binary bytes.
*.pdf binary

*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf
*.command text eol=lf
APPS/JFEM-solver/Linux/jfem text eol=lf
APPS/JFEM-solver/Mac/jfem text eol=lf

# Portable app scripts use LF; vendor archives keep exact verified upstream bytes.
WingFEGen/** text eol=lf
WingFEGen/*.cmd text eol=crlf
WingFEGen/web/vendor/** -text whitespace=cr-at-eol
APPS/JFEM-Boxer/web/vendor/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
APPS/PANDEATOR_APP/vendor/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol

# Execution receipts bind exact input/output bytes. Preserve this collection on
# every platform, including authored decks, numerical CSVs and figure sources.
validation/** -text whitespace=cr-at-eol
# Fixed-field decks and generated vector/numerical artifacts are verbatim data.
validation/cases/** -whitespace
