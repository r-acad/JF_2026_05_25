* text=auto

*.jl text eol=lf
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Published documents must retain their exact reviewed binary bytes.
*.pdf binary

*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf
*.command text eol=lf
/jfem text eol=lf

# Portable app scripts use LF; vendor archives keep exact verified upstream bytes.
WingFEGen/** text eol=lf
WingFEGen/*.cmd text eol=crlf
WingFEGen/web/vendor/** -text whitespace=cr-at-eol
