# Local/editor state
.claude/
.vscode/
.idea/

# Python environments and caches
.venv*/
__pycache__/
*.py[cod]

# Julia generated state
**/.julia/
**/deps/deps.jl
**/test/Manifest.toml

# Solver/generated outputs
output/
tmp_*

# JFEM-Boxer local definitions, imported reference assets and run products
APPS/JFEM-Boxer/input/
APPS/JFEM-Boxer/output/
APPS/JFEM-Boxer/**/*.wingfem.json
# Reviewed example studies are intentionally public.
!APPS/JFEM-Boxer/examples/**/*.wingfem.json
APPS/JFEM-Boxer/**/*.reference_assets/

# Locally generated sysimages created by each user's installation script
sysimage/
APPS/panel_runs/
APPS/PANDEATOR_APP/panel_runs/

# Reference/JFEM heavy run artifacts
*.f04
*.f06
*.log
*.op2
*.xdb
*.pch
*.h5
*.hdf5
*.vtk
*.vtu
*.vtp
*.jfem
*.JU.JSON
*.REPORT.md
run_manifest.json
batch_summary.csv
batch_summary.json
jfem_case_stdout.log
*.comparison_summary.json
*.plt
*.jls
*_kg_diag_*.csv

# LaTeX build products
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb

# External validation/reference payloads kept local
reference_data/
validation_data/
papers/

# Temporary/batch files
*.tmp
*.bak
*.orig

# Legacy local comparison output. The curated validation/ snapshot is versioned.
tools/validation_suite/comparison.csv
tools/validation_suite/comparison.md

# Curated, versioned validation evidence. Fresh user reruns stay local.
!validation/cases/*/results/*.jfem
!validation/cases/*/results/**/*.jfem
!validation/cases/*/convergence/*/results/*.jfem
!validation/cases/*/diagnostics/*/results/*.jfem
!validation/cases/*/results/*.JU.JSON
!validation/cases/*/results/**/*.JU.JSON
!validation/cases/*/convergence/*/results/*.JU.JSON
validation/cases/*/reruns/
validation/local_runs/
validation/_generated_cards/
